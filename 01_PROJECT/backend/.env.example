# Copy to 01_PROJECT/backend/.env and fill in. This file is committed; .env is NOT.
#
# ---------------------------------------------------------------------------
# AI Forecast Assistant (optional)
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
# The key is used server-side only and is never sent to the browser.
# Leave blank to run without the assistant: every other feature works, and
# /api/v1/genai/status reports why it is unavailable.
GEMINI_API_KEY=

# Optional overrides.
# Google retires model ids without much notice — if the assistant starts
# returning 404 NOT_FOUND, set a current one here rather than editing code.
# `gemini-flash-latest` is the alias that never 404s.
# NPN_GEMINI_MODEL=gemini-3.7-flash
# NPN_GENAI_ENABLED=true
# NPN_GENAI_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Service configuration (all optional; defaults resolve to the project layout)
# ---------------------------------------------------------------------------
# NPN_ENVIRONMENT=production
# NPN_DATA_DIR=/data/product
# NPN_PROJECT_ROOT=/research
# NPN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# NPN_LOG_LEVEL=INFO
# NPN_ENABLE_INFERENCE=true
