# Frontend configuration. Copy to .env.local for development overrides.
#
# API base URL. Leave UNSET in production when the frontend is served behind the
# same reverse proxy as the API — it then defaults to same-origin "/api/v1",
# which is what the nginx config in Dockerfile does.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Dev-only: where `npm run dev` proxies /api to.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
